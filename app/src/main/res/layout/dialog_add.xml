<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical"
 android:layout_width="match_parent"
 android:layout_height="wrap_content"
 android:padding="16dp">

 <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="إضافة بطولة جديدة"
  android:textStyle="bold" android:textSize="18sp"
  android:gravity="center" android:layout_marginBottom="12dp"
  android:textColor="#1E40AF"/>

 <EditText android:id="@+id/et_title"
  android:layout_width="match_parent" android:layout_height="50dp"
  android:hint="اسم البطولة - مثال: كأس الحامي"
  android:background="#F3F4F6" android:padding="12dp"
  android:layout_marginBottom="8dp"/>

 <EditText android:id="@+id/et_year"
  android:layout_width="match_parent" android:layout_height="50dp"
  android:hint="سنة البطولة - مثال: 2024"
  android:inputType="number"
  android:background="#F3F4F6" android:padding="12dp"
  android:layout_marginBottom="8dp"/>

 <EditText android:id="@+id/et_desc"
  android:layout_width="match_parent" android:layout_height="100dp"
  android:hint="نبذة عن البطولة"
  android:gravity="top" android:background="#F3F4F6"
  android:padding="12dp" android:layout_marginBottom="8dp"/>

 <Button android:id="@+id/btn_pick"
  android:layout_width="match_parent" android:layout_height="48dp"
  android:text="📷 اختر صورة البطولة"/>

 <ImageView android:id="@+id/img_preview"
  android:layout_width="match_parent" android:layout_height="150dp"
  android:layout_marginTop="8dp" android:background="#E5E7EB"
  android:scaleType="centerCrop"/>

</LinearLayout>
